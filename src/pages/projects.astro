---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("projects");
---

<Layout>
    <section
        class="py-20 md:py-24 bg-white dark:bg-slate-950 border-b border-slate-100 dark:border-slate-800/60"
    >
        <div class="max-w-7xl mx-auto px-5 md:px-10 lg:px-20">
            <p
                class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-3 tracking-wide uppercase"
            >
                Portfolio
            </p>
            <h1
                class="font-display font-bold text-5xl md:text-6xl text-slate-900 dark:text-slate-100 mb-5"
            >
                All Projects
            </h1>
            <p
                class="text-lg text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed"
            >
                A collection of things I've designed, built, and shipped. Each
                one taught me something new.
            </p>
        </div>
    </section>

    <div
        class="max-w-7xl mx-auto px-5 md:px-10 lg:px-20 py-16 grid md:grid-cols-2 lg:grid-cols-3 gap-6 bg-white dark:bg-slate-950"
    >
        {projects.map((project) => <ProjectCard project={project} />)}
    </div>
</Layout>
