---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const projects = await getCollection("projects");
import ProjectCard from "../components/ProjectCard.astro";
import filters from "../(data)/filters";
type Filter = (typeof filters)[number];
const active = 'All';

const visible = active === 'All' ? projects : projects.filter((p) => p.category === active);

---

<Layout>
    <section
        class="py-20 md:py-24 bg-white dark:bg-slate-950 border-b border-slate-100 dark:border-slate-800/60"
    >
        <div class="max-w-7xl mx-auto px-5 md:px-10 lg:px-20">
            <p
                class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-3 tracking-wide uppercase"
            >
                Portfolio
            </p>
            <h1
                class="font-display font-bold text-5xl md:text-6xl text-slate-900 dark:text-slate-100 mb-5"
            >
                All Projects
            </h1>
            <p
                class="text-lg text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed"
            >
                A collection of things I've designed, built, and shipped. Each
                one taught me something new.
            </p>
        </div>
    </section>

    <section class="py-16 bg-white dark:bg-slate-950">
        <div class="max-w-7xl mx-auto px-5 md:px-10 lg:px-20 text-white">
            {
                filters.map((f) => (
                    <button
                        class={`px-4 py-2 rounded-full text-sm font-medium transition-all focus-ring min-h-9}`}
               
                    >
                        {f}
                        {f !== "All" && (
                            <span class={`ml-1.5 text-xs `}>
                                (
                                {
                                    projects.filter((p) => p.category === f).length
                                        
                                }
                                )
                            </span>
                        )}
                    </button>
                ))
            }
        </div>
    </section>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article
            key={projects.id}
            onClick={() => navigate("project-detail", projects.id)}
            className="group card-hover cursor-pointer rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-xl hover:shadow-indigo-500/10"
        >
        </article>
    </div>

    <script>
        document.querySelectorAll(".project-card").forEach((card) => {
            card.addEventListener("click", () => {
                const projectId = card.getAttribute("data-project-id");
                // Replace this with your actual navigation logic (e.g., window.location.href)
                window.location.href = `src/project-detail/${projectId}`;
            });
        });
    </script>
</Layout>
