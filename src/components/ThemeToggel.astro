
<button
    class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus-ring cursor-pointer"
    aria-label="Toggle theme"
    data-theme-toggle
    ><span class="dark:hidden"
        ><svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class=""
            ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
            ></path></svg
        >
    </span>

    <span class="hidden dark:inline"
        ><svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class=""
            ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path></svg
        >
        </span
    >
   
</button>

<script>
	// Event delegation on `document` so this keeps working no matter how many
	// theme-toggle buttons exist on the page (mobile + desktop copies) and
	// survives Astro's client-side page transitions without needing to
	// rebind on every navigation.
	if (!(window as any).__themeToggleBound) {
		(window as any).__themeToggleBound = true;

		document.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement)?.closest(
				"[data-theme-toggle]",
			);
			if (!button) return;

			const isDark = document.documentElement.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});
	}
</script>
