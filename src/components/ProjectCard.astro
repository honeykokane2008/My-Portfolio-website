---
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, tagline, tech, accentColor } = project.data;
---

<a
    href={`/projects/${project.id}`}
    class="project-card group block rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-none"
    style={`--accent: ${accentColor}`}
>
    <div
        class="h-1 w-12 rounded-full mb-5 transition-all group-hover:w-16"
        style={`background-color: ${accentColor}`}
    >
    </div>

    <h2
        class="font-display font-bold text-xl text-slate-900 dark:text-slate-100 mb-2 transition-colors group-hover:text-(--accent)"
    >
        {title}
    </h2>

    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-4">
        {tagline}
    </p>

    <div class="flex flex-wrap gap-2">
        {
            tech.slice(0, 4).map((t) => (
                <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    {t}
                </span>
            ))
        }
        {
            tech.length > 4 && (
                <span class="text-xs font-medium px-2.5 py-1 text-slate-400">
                    +{tech.length - 4}
                </span>
            )
        }
    </div>
</a>
