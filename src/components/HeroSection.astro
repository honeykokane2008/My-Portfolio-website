---

---

<section
    class="relative min-h-screen flex items-center overflow-hidden bg-white dark:bg-slate-950 pt-16"
>
    <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-size-[64px_64px] opacity-60 dark:opacity-40"
    >
    </div>

    <div
        class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 rounded-full bg-indigo-500/10 dark:bg-indigo-500/15 blur-3xl pointer-events-none"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-5 md:px-10 lg:px-20 py-20 w-full">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div>
                <div
                    class="fade-up fade-up-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-indigo-200 dark:border-indigo-800 bg-indigo-50/80 dark:bg-indigo-950/50 text-sm text-indigo-700 dark:text-indigo-300 mb-6"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
                    ></span>Available for opportunities
                </div><h1
                    class="fade-up fade-up-2 font-display font-bold leading-tight mb-4"
                >
                    <span
                        class="text-5xl md:text-6xl lg:text-7xl text-slate-900 dark:text-slate-100 block"
                        >Hi, I'm</span
                    ><span
                        class="text-5xl md:text-6xl lg:text-7xl gradient-text block"
                        >Honey.</span
                    >
                </h1><p
                    class="fade-up fade-up-3 text-xl md:text-2xl text-slate-600 dark:text-slate-300 mb-3 font-display font-medium"
                >
                    I build fast, user-friendly web apps.
                </p><p
                    class="fade-up fade-up-3 text-base text-slate-500 dark:text-slate-400 mb-8 leading-relaxed max-w-lg"
                >
                    Full-stack developer specialising in React, Next.js, and
                    Node.js. Passionate about creating meaningful digital
                    experiences that actually ship.
                </p><div class="fade-up fade-up-4 flex flex-wrap gap-3">
                    <button
                        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-semibold transition-all hover:shadow-lg hover:shadow-indigo-500/30 focus-ring min-h-11"
                    >
                        <a href="projects">View Projects</a>
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class=""
                            ><line x1="5" y1="12" x2="19" y2="12"
                            ></line><polyline points="12 5 19 12 12 19"
                            ></polyline></svg
                        ></button
                    ><button
                        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 font-semibold transition-colors focus-ring min-h-11"
                        ><svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class=""
                            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                            ></path><polyline points="7 10 12 15 17 10"
                            ></polyline><line x1="12" y1="15" x2="12" y2="3"
                            ></line></svg
                        >
                        <a
                            href="/Honey-Kokane-Resume.pdf"
                            download="Honey-Kokane_Resume.pdf"
                        >
                            Download Resume
                        </a></button
                    >
                </div><div
                    class="fade-up fade-up-4 mt-10 flex items-center gap-6 text-sm text-slate-500 dark:text-slate-400"
                >
                    <div class="flex items-center gap-1.5">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-indigo-500"
                            ><polyline points="16 18 22 12 16 6"
                            ></polyline><polyline points="8 6 2 12 8 18"
                            ></polyline></svg
                        > 3+ projects shipped
                    </div><div class="flex items-center gap-1.5">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-emerald-500"
                            ><polyline points="20 6 9 17 4 12"></polyline></svg
                        > Open to remote
                    </div>
                </div>
            </div>
            <div class="flex justify-center lg:justify-end">
                <div class="relative">
                    <div
                        class="w-72 h-80 md:w-80 md:h-96 rounded-3xl overflow-hidden border-4 border-white dark:border-slate-800 shadow-2xl shadow-indigo-500/20"
                    >
                        <img
                            src="/public/honey-img.png"
                            alt="Honey — full-stack developer"
                            class="w-full h-full object-cover"
                        />
                    </div>

                    <div
                        class="absolute -bottom-4 -left-4 w-72 h-80 md:w-80 md:h-96 rounded-3xl border-2 border-indigo-200 dark:border-indigo-900 -z-10"
                    >
                    </div>

                    <div
                        class="absolute -bottom-6 -right-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 shadow-xl"
                    >
                        <div
                            class="text-2xl font-display font-bold gradient-text"
                        >
                            2+
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">
                            Projects shipped
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .gradient-text {
        background: linear-gradient(
            135deg,
            #6366f1 0%,
            #8b5cf6 50%,
            #a78bfa 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>
