---
import Navbar from "../components/Navbar.astro";
import  Footer  from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				function applyTheme() {
					const stored = localStorage.getItem("theme");
					const prefersDark = window.matchMedia(
						"(prefers-color-scheme: dark)",
					).matches;
					const isDark = stored ? stored === "dark" : prefersDark;
					document.documentElement.classList.toggle("dark", isDark);
				}

				// Run immediately so there's no flash on first load.
				applyTheme();

				// Astro's view-transition navigation re-syncs <html>'s
				// attributes to match the incoming page's raw markup, which
				// strips the "dark" class we add at runtime (it's never in
				// the actual HTML). Re-apply it right after each swap,
				// before the new page paints, so the theme doesn't flicker
				// or reset when navigating between pages.
				document.addEventListener("astro:after-swap", applyTheme);
			})();
		</script>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Honey Kokane - full stack devloper</title>
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	@font-face {
		font-family: "MyCustomFont";
		src: url("/fonts/my-custom-font.woff2") format("woff2");
		font-weight: normal;
		font-style: normal;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
